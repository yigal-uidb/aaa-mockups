      "label": "מחלקה",
      "plural": "מחלקות",
      "titleField": "name",
      "fields": [
        {
          "key": "name",
          "label": "שם המחלקה",
          "type": "text",
          "required": true
        },
        {
          "key": "manager",
          "label": "מנהל/ת המחלקה",
          "type": "user"
        },
        {
          "key": "categories",
          "label": "תחומים שהמחלקה מטפלת בהם",
          "type": "text"
        }
      ]

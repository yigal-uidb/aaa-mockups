{
  "name": "פניות תושבים",
  "description": "מוקד המועצה: קליטת פניות מהתושבים, ניתוב למחלקות, מעקב זמני טיפול ועדכון התושב",
  "entities": [
    {
      "key": "requests",
      "label": "פנייה",
      "plural": "פניות",
      "titleField": "title",
      "fields": [
        {
          "key": "title",
          "label": "נושא הפנייה",
          "type": "text",
          "required": true
        },
        {
          "key": "category",
          "label": "תחום",
          "type": "select",
          "options": [
            "מים וביוב",
            "תאורת רחוב",
            "גינון ושטחים פתוחים",
            "פסולת וניקיון",
            "כבישים ומדרכות",
            "בטיחות ומפגעים",
            "חינוך",
            "רווחה",
            "ארנונה וגבייה",
            "אחר"
          ],
          "required": true
        },
        {
          "key": "community",
          "label": "יישוב",
          "type": "ref",
          "ref": "communities"
        },
        {
          "key": "residentName",
          "label": "שם התושב",
          "type": "text",
          "required": true
        },
        {
          "key": "residentPhone",
          "label": "טלפון",
          "type": "text"
        },
        {
          "key": "residentEmail",
          "label": "דואר אלקטרוני (לעדכון על הטיפול)",
          "type": "text"
        },
        {
          "key": "channel",
          "label": "ערוץ",
          "type": "select",
          "options": [
            "מוקד טלפוני",
            "טופס באתר",
            "וואטסאפ",
            "פנייה בכתב",
            "בעל תפקיד ביישוב"
          ]
        },
        {
          "key": "address",
          "label": "יישוב וכתובת",
          "type": "text"
        },
        {
          "key": "description",
          "label": "פירוט",
          "type": "longtext"
        },
        {
          "key": "photo",
          "label": "תמונה",
          "type": "image"
        },
        {
          "key": "location",
          "label": "מיקום",
          "type": "location"
        },
        {
          "key": "urgency",
          "label": "דחיפות",

          "ref": "departments"
        },
        {
          "key": "assignee",
          "label": "מטפל/ת",
          "type": "user"
        },
        {
          "key": "status",
          "label": "סטטוס",
          "type": "select",
          "options": [
            "חדשה",
            "בטיפול",
            "ממתינה לקבלן",
            "טופלה",
            "נסגרה"
          ]
        },
        {
          "key": "dueDate",
          "label": "יעד לטיפול",
          "type": "date"
        },
        {
          "key": "overdue",
          "label": "חרגה מהיעד",
          "type": "boolean"
        },
        {
          "key": "escalated",
          "label": "הועברה להנהלה",
          "type": "boolean"
        },
        {
          "key": "resolution",
          "label": "מה נעשה",
          "type": "longtext"
        },
        {
          "key": "closedOn",
          "label": "תאריך סגירה",
          "type": "date"
        },
        {
          "key": "satisfaction",
          "label": "שביעות רצון התושב (1-5)",
          "type": "number"
        }
      ]
    },
    {
      "key": "communities",
      "label": "יישוב",
      "plural": "יישובים",
      "titleField": "name",
      "fields": [
        {
          "key": "name",
          "label": "שם היישוב",
          "type": "text",
          "required": true
        },
        {
          "key": "kind",
          "label": "סוג",
          "type": "select",
          "options": [
            "קיבוץ",
            "מושב",
            "כפר",
            "יישוב קהילתי"
          ]
        },
        {
          "key": "contact",
          "label": "רכז/ת היישוב",
          "type": "text"
        },
        {
          "key": "location",
          "label": "מיקום",
          "type": "location"
        }
      ]
    },
    {

      "moked": {
        "read": "all",
        "write": "all",
        "delete": false
      },
      "staff": {
        "read": "all",
        "write": "all",
        "delete": false
      },
      "deptManager": {
        "read": "all",
        "write": "all",
        "delete": false
      },
      "management": {
        "read": "all",
        "write": "all",
        "delete": true
      }
    },
    "communities": {
      "moked": {
        "read": "all",
        "write": "none"
      },
      "staff": {
        "read": "all",
        "write": "none"
      },
      "deptManager": {
        "read": "all",
        "write": "none"
      },
      "management": {
        "read": "all",
        "write": "all",
        "delete": true
      }
    },
    "departments": {
      "moked": {
        "read": "all",
        "write": "none"
      },
      "staff": {
        "read": "all",
        "write": "none"
      },
      "deptManager": {
        "read": "all",
        "write": "none"
      },
      "management": {
        "read": "all",
        "write": "all",
        "delete": true
      }
    }
  },
  "restrictedFields": [
    {
      "entity": "requests",
      "field": "satisfaction",
      "roles": [
        "staff"
      ]
    }
  ],
  "settings": [
    {
      "key": "slaDays",
      "label": "ימים לטיפול בפנייה רגילה",
      "description": "פנייה רגילה שלא טופלה עד אז מסומנת כחורגת ממנה",
      "type": "number",
      "default": 5,
      "min": 1,
      "max": 60
    },
    {
      "key": "urgentDays",
      "label": "ימים לטיפול בפנייה דחופה",
      "description": "פנייה דחופה או בטיחותית",
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 10
    },
    {
      "key": "escalateAfter",
      "label": "ימי חריגה עד העברה להנהלה",
      "description": "פנייה שחרגה מהיעד במספר ימים כזה עוברת לתשומת לב הנהלת המועצה",
      "type": "number",
      "default": 3,
      "min": 0,
      "max": 30
    }
  ],
  "workflow": {
    "title": "מפנייה של תושב ועד סגירה",
    "nodes": [
      {
        "id": "intake",
        "label": "קליטה וניתוב למחלקה",
        "kind": "step",
        "owner": "מוקד / טופס באתר"
      },
      {
        "id": "urgentCheck",
        "label": "דחופה או סכנה בטיחותית?",
        "kind": "decision",
        "setting": "urgentDays"
      },
      {
        "id": "alertManager",
        "label": "התראה מיידית למנהל המחלקה",
        "kind": "step",
        "owner": "מנהל מחלקה"
      },
      {
        "id": "handle",
        "label": "טיפול בשטח",
        "kind": "step",
        "owner": "עובד מחלקה"
      },
      {
        "id": "slaCheck",
        "label": "חרגה מהיעד?",
        "kind": "decision",
        "setting": "escalateAfter"
      },
      {
        "id": "escalate",
        "label": "העברה להנהלה",
        "kind": "step",
        "owner": "הנהלת המועצה"
      },
      {
        "id": "close",
        "label": "סגירה ועדכון התושב",
        "kind": "step",
        "owner": "עובד מחלקה"
      }
    ],
    "edges": [
      {
        "from": "intake",
        "to": "urgentCheck"
      },
      {
        "from": "urgentCheck",
        "to": "alertManager",
        "label": "כן"
      },
      {
        "from": "urgentCheck",
        "to": "handle",
        "label": "לא"
      },
      {
        "from": "alertManager",
        "to": "handle"
      },
      {
        "from": "handle",
        "to": "slaCheck"
      },
      {
        "from": "slaCheck",
        "to": "escalate",
        "label": "כן"
      },
      {
        "from": "slaCheck",
        "to": "close",
        "label": "לא"
      },
      {
        "from": "escalate",
        "to": "close"
      }
    ]
  },
  "pages": [
    {
      "key": "requests",
      "label": "פניות",
      "icon": "file"
    },
    {
      "key": "board",
      "label": "לוח טיפול",

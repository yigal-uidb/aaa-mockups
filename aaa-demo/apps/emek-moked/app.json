      "roles": [
        "management",
        "deptManager"
      ]
    },
    {
      "key": "communities",
      "label": "יישובים",
      "icon": "file",
      "roles": [
        "management",
        "moked"
      ]
    },
    {
      "key": "departments",
      "label": "מחלקות",
      "icon": "users",
      "roles": [
        "management"
      ]
    }
  ],
  "guidedTest": [
    {
      "key": "routed",
      "title": "פתחו פנייה בתחום תאורת רחוב, ובדקו שהיא נותבה למחלקת התחזוקה"
    },
    {
      "key": "urgent",
      "title": "פתחו פנייה עם סכנה בטיחותית, ובדקו שיעד הטיפול שלה הוא היום או מחר"
    },
    {
      "key": "closed",
      "title": "סגרו פנייה עם תיאור של מה שנעשה"
    }
  ],
  "actions": [
    {
      "key": "closeRequest",
      "title": "סגירת פנייה ועדכון התושב",
      "description": "מסמן את הפנייה כטופלה, שומר מה נעשה, ושולח לתושב עדכון בדואר אם יש כתובת",
      "input": {
        "id": "מזהה הפנייה",
        "resolution": "מה נעשה"
      }
    }
  ],
  "schedules": [
    {
      "key": "slaCheck",
      "title": "בדיקת בוקר: פניות שחרגו מהיעד, התראה למנהלי המחלקות והעברה להנהלה",
      "every": "day",
      "at": "07:00"
    }
  ],
  "publicForms": [
    {
      "key": "report",
      "title": "פנייה למועצה",
      "description": "נתקלתם במפגע, בתקלה או בבעיה ביישוב? כתבו לנו, ונעדכן אתכם כשהטיפול יסתיים.",
      "entity": "requests",
      "fields": [
        "residentName",
        "residentPhone",
        "residentEmail",
        "category",
        "title",
        "address",
        "description"
      ],
      "submitLabel": "שליחת הפנייה",
      "thanks": "תודה, הפנייה התקבלה במוקד המועצה. נעדכן אתכם בהמשך הטיפול."
    }
  ]
}
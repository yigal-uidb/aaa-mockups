  "roles": [
    {
      "key": "moked",
      "label": "מוקד"
    },
    {
      "key": "staff",
      "label": "עובד מחלקה"
    },
    {
      "key": "deptManager",
      "label": "מנהל מחלקה"
    },
    {
      "key": "management",
      "label": "הנהלת המועצה"
    }
  ],
  "permissions": {
